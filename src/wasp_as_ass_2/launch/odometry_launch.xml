<?xml version="1.0" encoding="UTF-8"?>
<launch>
	<arg name="rate" default="1.0" />

	<let name="rviz_config_file" value="$(find-pkg-share wasp_as_ass_2)/rviz/odometry.rviz" />

	<!-- Odometry -->

	<node pkg="wasp_as_ass_2" exec="odometry" name="odometry" output="screen">
		<param name="use_sim_time" value="true" />
	</node>

	<!-- rosbags/real_robot recorded /motor/encoders and /motor/duty_cyles
	     under the pre-rename wasp_autonomous_systems_interfaces message
	     types - bridge them to the current wasp_as_interfaces types (which
	     odometry.py subscribes to) so the rename is invisible here. See
	     src/wasp_autonomous_systems_interfaces/package.xml. -->

	<node pkg="wasp_as" exec="legacy_encoders_bridge" name="legacy_encoders_bridge" output="screen">
		<param name="use_sim_time" value="true" />
	</node>

	<!-- Rviz for visualization -->

	<node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_config_file)" output="screen" on_exit="shutdown">
		<param name="use_sim_time" value="true" />
	</node>

	<!-- Play the rosbag - remap the two legacy-typed topics so the bridge
	     above (not odometry.py) is the only thing that sees them.

	     -d 2.0: a fixed 2s startup delay so static TFs and subscriptions
	     settle before playback begins (same reason the assignment PDF's
	     own instructions use -p/start-paused, but -p needs a SPACE
	     keypress to resume - when this executable runs under `ros2
	     launch` its stdin usually isn't a real terminal ("stdin is not a
	     terminal device. Keyboard handling disabled." - confirmed via
	     live testing), so -p would just hang forever with no way to
	     unpause. -d is non-interactive and gives the same guarantee. -->

	<executable cmd="ros2 bag play rosbags/real_robot --read-ahead-queue-size 100 -l -r $(var rate) --clock 100 -d 2.0 --remap /motor/encoders:=/motor/encoders_legacy /motor/duty_cyles:=/motor/duty_cyles_legacy" output="screen" />
</launch>