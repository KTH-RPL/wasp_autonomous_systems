<?xml version="1.0" encoding="UTF-8"?>
<launch>
	<arg name="rate" default="1.0" />

	<let name="rviz_config_file" value="$(find-pkg-share wasp_as_ass_1)/rviz/kitti.rviz" />

	<!-- Rviz for visualization -->

	<node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_config_file)" ros_args="-p use_sim_time:=true" output="screen" on_exit="shutdown" />

	<!-- Robot state publisher to see car in Rviz -->

	<node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" ros_args="-p use_sim_time:=true" output="screen" respawn="true">
		<param name="robot_description" value="$(command 'xacro $(find-pkg-share wasp_as)/models/car.xacro')"/>
	</node>
	
	<!-- The rosbag is NOT played here - ros2 launch never gives a child
	     process a real terminal for stdin, so `ros2 bag play`'s keyboard
	     controls (space to pause/resume, etc.) are always disabled when
	     run this way, with no launch-XML option to change that. Play it
	     separately instead, in its own terminal - see ass_1_3_bag. -->
</launch>