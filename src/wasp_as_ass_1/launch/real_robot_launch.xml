<?xml version="1.0" encoding="UTF-8"?>
<launch>
	<arg name="rate" default="1.0" />

	<let name="rviz_config_file" value="$(find-pkg-share wasp_as_ass_1)/rviz/real_robot.rviz" />

	<!-- Rviz for visualization -->

	<node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_config_file)" ros_args="-p use_sim_time:=true" output="screen" on_exit="shutdown" />
	
	<!-- Play the rosbag -->

	<executable cmd="ros2 bag play --read-ahead-queue-size 100 -l -r $(var rate) --clock 100 rosbags/real_robot" output="screen" />
</launch>