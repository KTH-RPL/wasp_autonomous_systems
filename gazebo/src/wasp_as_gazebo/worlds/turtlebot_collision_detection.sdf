<?xml version="1.0"?>
<!--
  Assignment 2, collision detection task - Gazebo alternative to
  wasp_as_webots/worlds/turtlebot_collision_detection.wbt.

  Same arena as the Webots version: a 1 x 1 m floor boxed in by four
  0.98 x 0.02 x 0.1 walls at +/-0.5, with the robot starting in the middle.
  Same TurtleBot3 Burger drive geometry too (wheel separation 0.16, wheel
  radius 0.033, from wasp_as_webots/resource/ros2control.yaml), so the
  robot covers the room at the same rate and hits the walls just as often.

  The robot is deliberately sensor-poor: an IMU and nothing else. That is
  what the exercise needs (collision_detection.py only subscribes to /imu),
  and it is what keeps this world safe on macOS - no camera or GPU lidar
  means gz-sim-sensors-system, whose Ogre2 initialization segfaults there,
  is never loaded at all.

  The IMU noise matches the accelerometer parameters the Webots Ros2IMU
  plugin is given in wasp_as_webots/resource/turtlebot_webots.urdf (bias
  0.1-0.3, stddev 0.1), so a threshold tuned in one simulator is a
  reasonable threshold in the other.
-->
<sdf version="1.9">
  <world name="turtlebot_collision_detection">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_1">
      <static>true</static>
      <pose>0.5 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
          <material>
            <ambient>0.125 0.369 0.729 1</ambient>
            <diffuse>0.125 0.369 0.729 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_2">
      <static>true</static>
      <pose>-0.5 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
          <material>
            <ambient>0.125 0.369 0.729 1</ambient>
            <diffuse>0.125 0.369 0.729 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_3">
      <static>true</static>
      <pose>0 -0.5 0.05 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
          <material>
            <ambient>0.125 0.369 0.729 1</ambient>
            <diffuse>0.125 0.369 0.729 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_4">
      <static>true</static>
      <pose>0 0.5 0.05 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.98 0.1</size></box></geometry>
          <material>
            <ambient>0.125 0.369 0.729 1</ambient>
            <diffuse>0.125 0.369 0.729 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Named TurtleBot3Burger to match the Webots robot name, so the
         /TurtleBot3Burger/gps topic collision_detection.rviz is configured
         against comes out the same (published by gps_bridge.py off this
         model's ground-truth pose, see the OdometryPublisher below). -->
    <model name="TurtleBot3Burger">
      <pose>0 0 0.033 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.0035</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0035</iyy>
            <iyz>0</iyz>
            <izz>0.0035</izz>
          </inertia>
        </inertial>
        <!-- Offset upwards by 0.037: base_link's origin is at wheel-axle
             height (0.033), so a 0.12-tall box centred there would reach
             0.027 m below the floor. It does - confirmed live, the robot
             then rests on its own hull, the wheels barely touch, and it
             never moves an inch while wheel odometry happily integrates
             (it reported 137 m). Offset like this the hull spans 0.010 to
             0.130, clear of the floor and overlapping the 0.1-tall walls. -->
        <collision name="collision">
          <pose>0 0 0.037 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.037 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.12</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

        <!-- 1000 Hz, matching the physics step, rather than the 100 Hz the
             Webots robot uses. Gazebo's contacts are rigid, so a collision
             is an impulse roughly one physics step long. Sampled slower than
             the step, the IMU catches it only when a sample happens to land
             inside it, and the same run then behaves differently every time.
             Webots needs no equivalent: its contact solver spreads the same
             collision over a much longer transient. -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>1000</update_rate>
          <topic>imu</topic>
          <imu>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                  <bias_mean>0.2</bias_mean>
                  <bias_stddev>0.1</bias_stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                  <bias_mean>0.2</bias_mean>
                  <bias_stddev>0.1</bias_stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.1</stddev>
                  <bias_mean>0.2</bias_mean>
                  <bias_stddev>0.1</bias_stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <link name="wheel_left_link">
        <pose>0 0.08 0 -1.5708 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.5e-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.5e-05</iyy>
            <iyz>0</iyz>
            <izz>2.7e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.033</radius>
              <length>0.018</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.033</radius>
              <length>0.018</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="wheel_left_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_left_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
      </joint>

      <link name="wheel_right_link">
        <pose>0 -0.08 0 -1.5708 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.5e-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.5e-05</iyy>
            <iyz>0</iyz>
            <izz>2.7e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.033</radius>
              <length>0.018</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.033</radius>
              <length>0.018</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="wheel_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_right_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
      </joint>

      <!-- Caster: a low-friction sphere instead of a third wheel, same role
           as the Burger's real caster. Without it the two-wheeled body
           tips forward onto its nose and the IMU never sees a clean
           collision spike. -->
      <link name="caster_link">
        <pose>-0.05 0 -0.023 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-06</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1e-06</iyy>
            <iyz>0</iyz>
            <izz>1e-06</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.01</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.01</mu>
                <mu2>0.01</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.01</radius></sphere></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster_link</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.16</wheel_separation>
        <wheel_radius>0.033</wheel_radius>

        <!-- Without these the drive controller steps straight to whatever
             velocity it is given, so every change of command shows up on the
             IMU as an artefact of the command rather than of anything the
             robot ran into. Ramping instead keeps ordinary driving smooth.
             All four bounds are needed, not just the max pair: min_* govern
             braking and reversing, which is most of what the recovery
             manoeuvre does. They shape only the commanded wheel velocities,
             so contact forces are unaffected. The Webots robot gets the same
             smoothing from its own motors' acceleration limits. -->
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
        <min_angular_acceleration>-2.0</min_angular_acceleration>

        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>

      <!-- Ground-truth pose, on a topic of its own so it does not collide
           with DiffDrive's /model/TurtleBot3Burger/odometry above. This is
           what feeds /TurtleBot3Burger/gps, and it has to be ground truth:
           DiffDrive's odometry is integrated from wheel rotation, so once
           the robot is wedged against a wall with its wheels still turning
           it keeps reporting motion forever (confirmed live - it read 137 m
           while the robot had not moved in minutes). Webots' GPS device,
           which the exercise and collision_detection.rviz are written
           against, reports true position. -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/TurtleBot3Burger/ground_truth_odometry</odom_topic>
      </plugin>
    </model>

  </world>
</sdf>
