<?xml version="1.0"?>
<!--
  Assignment 4 (altitude control), Gazebo alternative to
  wasp_as_webots/worlds/course_mavic_world.wbt.

  The quadrotor is tuned to the Webots Mavic 2 PRO's flight numbers rather
  than to Gazebo's stock X3, so students get the same answers in either
  simulator (see docs/gazebo-alternative.md):
    - motorConstant 2.6e-4  = the Mavic proto's thrustConstants
    - momentConstant 0.02   = its torqueConstants / thrustConstants
    - maxRotVelocity 576    = its RotationalMotor maxVelocity
    - total mass 0.5 kg     = the Mavic's effective mass
  which together put hover at sqrt(0.5 * 9.8 / 4 / 2.6e-4) ~= 68.5 rad/s,
  the Mavic's well-known hover thrust. Rotor positions are the Mavic's
  centerOfThrust values. The moments of inertia are Gazebo's own X3 values
  scaled to this mass - the X3 is known to fly stably under gz-sim's
  solver, and its arm lengths are close enough to the Mavic's for those to
  carry over.

  No <include> of anything from Fuel: the ground plane and sun are inlined
  so the world loads with no network access, which matters for exactly the
  locked-down machines this alternative exists for.

  Deliberately no gz-sim-sensors-system: that is the rendering-backed
  sensor system (cameras, GPU lidar) whose Ogre2 initialization segfaults
  on macOS. The IMU below runs on gz-sim-imu-system, which does no
  rendering, so this world is safe on every platform.
-->
<sdf version="1.9">
  <world name="course_quadrotor">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="quadrotor">
      <pose>0 0 0.065 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>0.48</mass>
          <inertia>
            <ixx>0.0116</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0233</iyy>
            <iyz>0</iyz>
            <izz>0.0326</izz>
          </inertia>
        </inertial>
        <collision name="base_link_collision">
          <geometry>
            <box>
              <size>0.25 0.20 0.07</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_link_visual">
          <geometry>
            <box>
              <size>0.25 0.20 0.07</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

        <!-- Noise-free on purpose: the Webots plugin this mirrors reads the
             inertial unit and gyro directly, which are noise-free there, so
             adding noise here would make the two simulators behave
             differently for no pedagogical gain. update_rate 125 matches
             Webots' basicTimeStep of 8 ms. -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>125</update_rate>
          <topic>imu</topic>
        </sensor>
      </link>

      <!-- Rotor 0: front right. Rotor positions are the Mavic's
           centerOfThrust values, mirrored where the Mavic is asymmetric so
           the mixing in mavic_controller.py stays a clean +/- roll/pitch
           split. -->
      <link name="rotor_0">
        <pose>0.15 -0.15 0.032 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>4.17041e-05</iyy>
            <iyz>0</iyz>
            <izz>4.26041e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_0_visual">
          <geometry>
            <cylinder>
              <length>0.005</length>
              <radius>0.1</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_0</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
      </joint>

      <!-- Rotor 1: front left -->
      <link name="rotor_1">
        <pose>0.15 0.15 0.032 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>4.17041e-05</iyy>
            <iyz>0</iyz>
            <izz>4.26041e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_1_visual">
          <geometry>
            <cylinder>
              <length>0.005</length>
              <radius>0.1</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_1</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
      </joint>

      <!-- Rotor 2: rear right -->
      <link name="rotor_2">
        <pose>-0.15 -0.15 0.032 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>4.17041e-05</iyy>
            <iyz>0</iyz>
            <izz>4.26041e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_2_visual">
          <geometry>
            <cylinder>
              <length>0.005</length>
              <radius>0.1</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_2</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
      </joint>

      <!-- Rotor 3: rear left -->
      <link name="rotor_3">
        <pose>-0.15 0.15 0.032 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>4.17041e-05</iyy>
            <iyz>0</iyz>
            <izz>4.26041e-05</izz>
          </inertia>
        </inertial>
        <visual name="rotor_3_visual">
          <geometry>
            <cylinder>
              <length>0.005</length>
              <radius>0.1</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <parent>base_link</parent>
        <child>rotor_3</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
        </axis>
      </joint>

      <!-- turningDirection groups front-right + rear-left against
           front-left + rear-right, the same grouping Webots gets from the
           signs in Ros2MavicController.cpp's wb_motor_set_velocity calls.
           mavic_controller.py's yaw term depends on that grouping. -->
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>quadrotor</robotNamespace>
        <jointName>rotor_0_joint</jointName>
        <linkName>rotor_0</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>576.0</maxRotVelocity>
        <motorConstant>2.6e-04</motorConstant>
        <momentConstant>0.02</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>0</motorNumber>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>quadrotor</robotNamespace>
        <jointName>rotor_1_joint</jointName>
        <linkName>rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>576.0</maxRotVelocity>
        <motorConstant>2.6e-04</motorConstant>
        <momentConstant>0.02</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>1</motorNumber>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>quadrotor</robotNamespace>
        <jointName>rotor_2_joint</jointName>
        <linkName>rotor_2</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>576.0</maxRotVelocity>
        <motorConstant>2.6e-04</motorConstant>
        <momentConstant>0.02</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>2</motorNumber>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>quadrotor</robotNamespace>
        <jointName>rotor_3_joint</jointName>
        <linkName>rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>576.0</maxRotVelocity>
        <motorConstant>2.6e-04</motorConstant>
        <momentConstant>0.02</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>3</motorNumber>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <!-- Height for the exercise files, via gps_bridge.py. dimensions 3
           because altitude is the whole point here. -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_publish_frequency>125</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
